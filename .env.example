# Defaults work without this file. Copy to .env.local only to override them.
INVENTORY_URL=http://127.0.0.1:4311
PAYMENT_URL=http://127.0.0.1:4312
DELIVERY_URL=http://127.0.0.1:4313
# Server-side only. Never prefix this with NEXT_PUBLIC_.
# GATEWAY_TOKEN=
# OAuth alternative: automatically refresh a short-lived client-credentials token.
# Select only services actually routed through your gateway.
# GATEWAY_SERVICES=delivery
# GATEWAY_TOKEN_URL=https://localhost:9443/oauth2/token
# GATEWAY_CLIENT_ID=
# GATEWAY_CLIENT_SECRET=
# Export NODE_EXTRA_CA_CERTS before starting Node for a privately trusted certificate.
# BALLERINA_AUDITOR_URL=http://127.0.0.1:4314
# Hosted web app: set these privately in Vercel, not in Git.
# BACKEND_URL=https://your-backend-domain
# BACKEND_TOKEN=
# APP_ORIGIN=https://your-app-domain
# Backend only: point to a mounted persistent directory.
# REHEARSAL_DATA_DIR=/data
